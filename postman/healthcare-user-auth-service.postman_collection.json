  "item": [
    {
      "name": "1. Authentication & Session (Keycloak OIDC)",
      "item": [
        {
          "name": "1.1 Login - Doctor / Clinician",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.access_token) {",
                  "        pm.collectionVariables.set('accessToken', json.access_token);",
                  "        console.log('Access token saved to collection variable.');",
                  "    }",
                  "    if (json.refresh_token) {",
                  "        pm.collectionVariables.set('refreshToken', json.refresh_token);",
                  "        console.log('Refresh token saved to collection variable.');",
                  "    }",
                  "    pm.test('Status code is 200 and access_token present', function () {",
                  "        pm.response.to.have.status(200);",
                  "        pm.expect(json.access_token).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"doctor_smith\",\n  \"password\": \"doctorpassword123\",\n  \"deviceId\": \"WORKSTATION-ICU-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticates user with Keycloak IAM credentials. Automatically stores access_token and refresh_token in Postman variables."
          },
          "response": []
        },
        {
          "name": "1.2 Login - Admin User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.access_token) {",
                  "        pm.collectionVariables.set('accessToken', json.access_token);",
                  "    }",
                  "    if (json.refresh_token) {",
                  "        pm.collectionVariables.set('refreshToken', json.refresh_token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"admin_sarah\",\n  \"password\": \"adminpassword123\",\n  \"deviceId\": \"SECURE-ADMIN-CONSOLE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticates Admin user with Keycloak IAM."
          },
          "response": []
        },
        {
          "name": "1.3 Login with 2FA / TOTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"doctor_smith\",\n  \"password\": \"doctorpassword123\",\n  \"totpCode\": \"123456\",\n  \"deviceId\": \"WORKSTATION-ICU-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticates user with password and time-based one-time password (TOTP)."
          },
          "response": []
        },
        {
          "name": "1.4 Refresh Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.access_token) {",
                  "        pm.collectionVariables.set('accessToken', json.access_token);",
                  "    }",
                  "    if (json.refresh_token) {",
                  "        pm.collectionVariables.set('refreshToken', json.refresh_token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            },
            "description": "Refreshes expired access tokens using the OIDC Refresh Token Grant."
          },
          "response": []
        },
        {
          "name": "1.5 Get Current User Profile (/me)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Returns authenticated user claims, subject UUID, and Keycloak roles from JWT."
          },
          "response": []
        },
        {
          "name": "1.6 Logout & Revoke Session",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\",\n  \"all_sessions\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Terminates Keycloak active session and revokes refresh token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. HIPAA 2FA & Security Verification",
      "item": [
        {
          "name": "2.1 Setup TOTP 2FA Secret & QR Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.secret) {",
                  "        pm.collectionVariables.set('totpSecret', json.secret);",
                  "        console.log('TOTP Secret stored: ' + json.secret);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/totp/setup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "totp", "setup"]
            },
            "description": "Generates a RFC 6238 TOTP Base32 secret and QR Code Data URI for Google Authenticator."
          },
          "response": []
        },
        {
          "name": "2.2 Verify TOTP Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"secret\": \"{{totpSecret}}\",\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/totp/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "totp", "verify"]
            },
            "description": "Validates a 6-digit TOTP code against the generated secret."
          },
          "response": []
        },
        {
          "name": "2.3 Audit Logs (Admin Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/audit-logs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "audit-logs"]
            },
            "description": "Fetches recent HIPAA audit log entries (logins, logouts, failures, IP, User Agent). Requires ADMIN role."
          },
          "response": []
        },
        {
          "name": "2.4 Verify Doctor License (Admin Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/doctor/verify-license?doctorId={{doctorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "doctor", "verify-license"],
              "query": [
                {
                  "key": "doctorId",
                  "value": "{{doctorId}}"
                }
              ]
            },
            "description": "Admin verification of physician medical license in state registry."
          },
          "response": []
        }
      ]
    },
