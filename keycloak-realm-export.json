{
  "id": "healthcare-realm",
  "realm": "healthcare-realm",
  "displayName": "Healthcare RPM & Telehealth Realm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "id": "role-doctor-reader-id",
        "name": "Doctor-Reader",
        "description": "Clinical practitioner with read-only clearance for medical documents (document:read PERMIT, document:edit DENY)",
        "composite": false,
        "clientRole": false,
        "containerId": "healthcare-realm",
        "attributes": {
          "clearance_level": ["LEVEL_2_READER"],
          "department": ["CLINICAL_MEDICINE"]
        }
      },
      {
        "id": "role-doctor-editor-id",
        "name": "Doctor-Editor",
        "description": "Clinical attending physician with full document authoring and edit clearance (document:read PERMIT, document:edit PERMIT)",
        "composite": false,
        "clientRole": false,
        "containerId": "healthcare-realm",
        "attributes": {
          "clearance_level": ["LEVEL_3_EDITOR"],
          "department": ["CLINICAL_MEDICINE"]
        }
      },
      {
        "id": "role-patient-id",
        "name": "PATIENT",
        "description": "Patient user with self-telemetry and personal medical records access",
        "composite": false,
        "clientRole": false,
        "containerId": "healthcare-realm",
        "attributes": {
          "clearance_level": ["LEVEL_1"],
          "department": ["PATIENT_PORTAL"]
        }
      },
      {
        "id": "role-doctor-id",
        "name": "DOCTOR",
        "description": "Attending Physician / Clinician with EHR prescription and diagnostic clearance",
        "composite": false,
        "clientRole": false,
        "containerId": "healthcare-realm",
        "attributes": {
          "clearance_level": ["LEVEL_3"],
          "dea_prescribing_active": ["true"],
          "department": ["CLINICAL_MEDICINE"]
        }
      },
      {
        "id": "role-nurse-id",
        "name": "NURSE",
        "description": "Registered Nurse for remote patient monitoring, vitals triage, and emergency dispatch",
        "composite": false,
        "clientRole": false,
        "containerId": "healthcare-realm",
        "attributes": {
          "clearance_level": ["LEVEL_2"],
          "department": ["TRIAGE_RPM"]
        }
      },
      {
        "id": "role-pharmacist-id",
        "name": "PHARMACIST",
        "description": "Licensed Pharmacist with digital POD signing and cold-chain fulfillment clearance",
        "composite": false,
        "clientRole": false,
        "containerId": "healthcare-realm",
        "attributes": {
          "clearance_level": ["LEVEL_2"],
          "license_verified": ["true"],
          "department": ["PHARMACY_FULFILLMENT"]
        }
      },
      {
        "id": "role-labtech-id",
        "name": "LAB_TECH",
        "description": "Laboratory Diagnostic Specialist for test execution and diagnostic validation",
        "composite": false,
        "clientRole": false,
        "containerId": "healthcare-realm",
        "attributes": {
          "clearance_level": ["LEVEL_2"],
          "department": ["PATHOLOGY_LAB"]
        }
      },
      {
        "id": "role-admin-id",
        "name": "ADMIN",
        "description": "System administrator with full RBAC governance and HIPAA audit log access",
        "composite": false,
        "clientRole": false,
        "containerId": "healthcare-realm",
        "attributes": {
          "clearance_level": ["LEVEL_4_ROOT"],
          "hipaa_officer": ["true"]
        }
      },
      {
        "id": "role-cmo-id",
        "name": "CHIEF_MEDICAL_OFFICER",
        "description": "Executive composite role inheriting DOCTOR, NURSE, and LAB_TECH administrative oversight",
        "composite": true,
        "clientRole": false,
        "containerId": "healthcare-realm",
        "composites": {
          "realm": [
            "DOCTOR",
            "NURSE",
            "LAB_TECH"
          ]
        },
        "attributes": {
          "clearance_level": ["LEVEL_4_EXECUTIVE"],
          "executive_board": ["true"]
        }
      }
    ]
  },
  "clientScopes": [
    {
      "id": "scope-document-read-id",
      "name": "document:read",
      "description": "Permission scope to read, list, and view medical documents",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Read medical documents and health records"
      }
    },
    {
      "id": "scope-document-edit-id",
      "name": "document:edit",
      "description": "Permission scope to create, update, and delete medical documents",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Create, modify, and delete medical documents"
      }
    }
  ],
  "clients": [
    {
      "id": "client-api-gateway-id",
      "clientId": "healthcare-api-gateway",
      "name": "Healthcare API Gateway & Resource Server",
      "description": "Spring Cloud API Gateway & Resource Server Client with Keycloak Authorization Services (UMA 2.0)",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "hExghH54qXgHTl3WnNJJ1nCW2dxeRBI1",
      "bearerOnly": false,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8080/*",
        "http://localhost:8081/*"
      ],
      "webOrigins": [
        "*"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "document:read",
        "document:edit"
      ],
      "protocolMappers": [
        {
          "id": "mapper-realm-roles",
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "id": "mapper-username",
          "name": "username-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "user.attribute": "username"
          }
        }
      ],
      "authorizationSettings": {
        "allowRemoteResourceManagement": true,
        "policyEnforcementMode": "ENFORCING",
        "decisionStrategy": "AFFIRMATIVE",
        "scopes": [
          {
            "id": "authz-scope-read",
            "name": "document:read",
            "displayName": "Read Document Scope"
          },
          {
            "id": "authz-scope-edit",
            "name": "document:edit",
            "displayName": "Edit Document Scope"
          }
        ],
        "resources": [
          {
            "name": "Medical Document Resource",
            "ownerManagedAccess": false,
            "displayName": "Medical Documents & EHR Records",
            "attributes": {
              "endpoint": ["/api/v1/documents/*"]
            },
            "uris": [
              "/api/v1/documents",
              "/api/v1/documents/*"
            ],
            "scopes": [
              {
                "name": "document:read"
              },
              {
                "name": "document:edit"
              }
            ],
            "type": "urn:healthcare:resource:document"
          }
        ],
        "policies": [
          {
            "id": "policy-doctor-reader",
            "name": "Doctor-Reader Policy",
            "description": "Applies authorization to users possessing the Doctor-Reader realm role",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"role-doctor-reader-id\",\"required\":true}]"
            }
          },
          {
            "id": "policy-doctor-editor",
            "name": "Doctor-Editor Policy",
            "description": "Applies authorization to users possessing the Doctor-Editor realm role",
            "type": "role",
            "logic": "POSITIVE",
            "decisionStrategy": "UNANIMOUS",
            "config": {
              "roles": "[{\"id\":\"role-doctor-editor-id\",\"required\":true}]"
            }
          },
          {
            "id": "perm-read-document",
            "name": "Read Document Permission",
            "description": "Scope-based permission: Target Scope = document:read. Applied to Doctor-Reader Policy & Doctor-Editor Policy",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "defaultResourceType": "urn:healthcare:resource:document",
              "default": "true",
              "scopes": "[\"document:read\"]",
              "applyPolicies": "[\"Doctor-Reader Policy\",\"Doctor-Editor Policy\"]"
            }
          },
          {
            "id": "perm-edit-document",
            "name": "Edit Document Permission",
            "description": "Scope-based permission: Target Scope = document:edit. Applied to Doctor-Editor Policy (Doctor-Reader defaults to DENY)",
            "type": "scope",
            "logic": "POSITIVE",
            "decisionStrategy": "AFFIRMATIVE",
            "config": {
              "defaultResourceType": "urn:healthcare:resource:document",
              "default": "true",
              "scopes": "[\"document:edit\"]",
              "applyPolicies": "[\"Doctor-Editor Policy\"]"
            }
          }
        ]
      }
    },
    {
      "id": "client-web-portal-id",
      "clientId": "healthcare-web-app",
      "name": "Healthcare Web & Mobile Portal",
      "description": "SPA and Mobile Native Application Client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "*"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ]
    },
    {
      "id": "client-admin-cli-id",
