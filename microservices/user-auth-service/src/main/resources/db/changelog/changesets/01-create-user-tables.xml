<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="01-create-users-and-audit-tables" author="healthcare-architect">
        <createTable tableName="user_accounts">
            <column name="id" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(100)"/>
            <column name="last_name" type="VARCHAR(100)"/>
            <column name="role" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="phone_number" type="VARCHAR(32)"/>
            <column name="is_totp_enabled" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="totp_secret" type="VARCHAR(128)"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createTable tableName="doctor_profiles">
            <column name="doctor_id" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="medical_license_number" type="VARCHAR(64)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="specialty" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="years_of_experience" type="INTEGER"/>
            <column name="is_verified" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="verified_by_admin" type="VARCHAR(64)"/>
            <column name="verification_timestamp" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="consultation_fee" type="DECIMAL(10,2)"/>
        </createTable>

        <createTable tableName="auth_audit_logs">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="ip_address" type="VARCHAR(64)"/>
            <column name="user_agent" type="VARCHAR(255)"/>
            <column name="status" type="VARCHAR(32)"/>
            <column name="hipaa_event_type" type="VARCHAR(64)"/>
            <column name="timestamp" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <createIndex indexName="idx_audit_user_timestamp" tableName="auth_audit_logs">
            <column name="user_id"/>
            <column name="timestamp"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
